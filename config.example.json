{
  "overlay": {
    "command": "~/.local/bin/hud",
    "textSize": 22,
    "padding": 20,
    "position": { "x": 50, "y": 18 },
    "durationMs": 800
  },
  "connectingLabel": "ACK05 connecting…",
  "connectedLabel": "ACK05 ready",
  "disconnectedLabel": "",
  "buttons": {
    "BTN_1": { "type": "shell", "command": "open -a Safari", "label": "Safari" },
    "BTN_2": { "type": "shell", "command": "open -a Notes", "label": "Notes" },
    "BTN_3": { "type": "keystroke", "keystroke": "shift+cmd+4", "label": "screenshot" },
    "BTN_4": { "type": "battery", "label": "ACK05" },
    "DIAL":  { "type": "wheelModeCycle" }
  },
  "wheelModes": [
    {
      "name": "volume",
      "cw":  { "type": "mediaKey", "key": "volume_up" },
      "ccw": { "type": "mediaKey", "key": "volume_down" }
    },
    {
      "name": "zoom",
      "cw":  { "type": "keystroke", "keystroke": "cmd+=" },
      "ccw": { "type": "keystroke", "keystroke": "cmd+-" }
    }
  ]
}
